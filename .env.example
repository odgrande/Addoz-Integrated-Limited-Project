# ── Required ────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Better Auth: a long random secret (openssl rand -base64 32) and the public site URL
BETTER_AUTH_SECRET="your_secret_here"
BETTER_AUTH_URL="https://addoz.com"
# Same public URL, used for absolute links (sitemap, emails)
NEXT_PUBLIC_APP_URL="https://addoz.com"
# Optional extra hostnames allowed to serve the app (comma separated), e.g. "www.addoz.com"
AUTH_ALLOWED_HOSTS=""

# Signs the guest-application continuity cookie (random string)
GUEST_APP_SECRET="your_random_secret"

# ── Email (required for OTP codes, password resets and notifications) ───────
# Resend API key and a verified sender, e.g. "ADDOZ <no-reply@addoz.com>"
RESEND_API_KEY=""
EMAIL_FROM=""
# Where contact-form messages are forwarded (defaults to the site email)
CONTACT_EMAIL=""

# ── File storage (required in production for CV uploads) ─────────────────────
R2_ACCOUNT_ID="your_account_id"
R2_BUCKET="addoz-resumes"
R2_ACCESS_KEY_ID="your_access_key_id"
R2_SECRET_ACCESS_KEY="your_secret_access_key"
R2_ENDPOINT_URL="https://your_account_id.r2.cloudflarestorage.com"
R2_MAX_FILE_SIZE="10485760"
# Development only: set to "none" to disable the local .data/uploads fallback
# STORAGE_DRIVER=""

# ── First admin (used by `pnpm admin:create`) ────────────────────────────────
ADMIN_EMAIL=""
ADMIN_NAME="ADDOZ Administrator"
ADMIN_PASSWORD=""
